%% Les vérifications automatiques: leurs tâches, et ce qui se passe selon l'évènement.
%% Source de 04-les-verifications-automatiques.svg. L'image ne se retouche jamais à la main.
%% Après une modification, depuis la racine du dépôt:
%%   docker compose -f docs/outils/compose.yaml run --rm schemas
%% Depuis le 04/10/2026 (plan 17): le déploiement automatique commun par image de Harbor.
%% Depuis le 05/10/2026 (décisions 124 et 125): le workflow d'un sous-projet, lancé quand
%% un évènement le modifie; à côté, sans l'attendre, les vérifications communes du dépôt.
flowchart TB
  evenement(["Un évènement sur GitHub<br>qui modifie le sous-projet"])
  communes["À côté, sans l'attendre:<br>les vérifications communes<br>attribution, secrets, typographie, YAML,<br>à chaque évènement, pour tout le dépôt"]:::discret
  rapides["Vérifications rapides du sous-projet<br>sa composition,<br>ce qui lui est propre"]
  quoi{"Qu'est-ce qui a lancé<br>les vérifications ?"}
  tests["Tests du code<br>les tests propres<br>à l'application"]
  pr["Une PR vers test ne met rien en ligne<br>le résumé s'affiche sur la PR"]:::discret
  existe{"L'image de ce contenu<br>est-elle dans Harbor ?"}
  construire["Construire l'image une seule fois,<br>la contrôler, la ranger dans Harbor"]
  trivy["En même temps que la mise en ligne,<br>Trivy lit les failles<br>informe, ne bloque pas"]:::discret
  enligne["Mettre en ligne en test<br>#lt;application#gt;-test, puis vérifier la santé"]
  testee{"L'image testée<br>est-elle dans Harbor ?"}:::accent
  refus["Refus net<br>rien n'est mis en ligne"]:::attention
  prtest["PR de test vers main<br>ni tests ni construction"]:::discret
  enprod["Mettre en ligne en production<br>la même image, puis vérifier la santé"]
  echec["Une tâche en échec<br>arrête les suivantes,<br>rien n'est mis en ligne"]:::attention

  evenement --> rapides --> quoi
  evenement -.- communes
  quoi -- "une PR vers test" --> tests
  tests -- "PR vers test" --> pr
  quoi -- "une fusion dans test" --> tests
  tests -- "fusion dans test" --> existe
  existe -- "non" --> construire --> enligne
  existe -- "oui" --> enligne
  enligne -.- trivy
  quoi -- "une PR de test vers main,<br>ou une fusion dans main" --> testee
  testee -- "non" --> refus
  testee -- "oui, pour la PR" --> prtest
  testee -- "oui, pour main" --> enprod
  rapides -. "en échec" .-> echec
  tests -. "en échec" .-> echec
