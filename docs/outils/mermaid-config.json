{
  "theme": "base",
  "handDrawnSeed": 1,
  "htmlLabels": false,
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "padding": 12,
    "wrappingWidth": 320,
    "useMaxWidth": false
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false,
    "wrap": true,
    "width": 130,
    "actorMargin": 30,
    "messageMargin": 30
  },
  "gitGraph": {
    "useMaxWidth": false,
    "mainBranchName": "main",
    "showCommitLabel": false
  },
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#1B1D1E",
    "primaryBorderColor": "#1B1D1E",
    "secondaryColor": "#f3f1ec",
    "tertiaryColor": "#eae7df",
    "lineColor": "#33383a",
    "textColor": "#1B1D1E",
    "clusterBkg": "#f3f1ec",
    "clusterBorder": "#6b6b6b",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#ffffff",
    "actorBorder": "#1B1D1E",
    "actorTextColor": "#1B1D1E",
    "actorLineColor": "#6b6b6b",
    "signalColor": "#1B1D1E",
    "signalTextColor": "#1B1D1E",
    "labelBoxBkgColor": "#f3f1ec",
    "labelBoxBorderColor": "#6b6b6b",
    "labelTextColor": "#1B1D1E",
    "loopTextColor": "#1B1D1E",
    "noteBkgColor": "#f3f1ec",
    "noteBorderColor": "#6b6b6b",
    "noteTextColor": "#1B1D1E",
    "activationBkgColor": "#eae7df",
    "activationBorderColor": "#6b6b6b",
    "sequenceNumberColor": "#ffffff",
    "git0": "#D85810",
    "git1": "#1B1D1E",
    "git2": "#6b6b6b",
    "git3": "#6b6b6b",
    "git4": "#6b6b6b",
    "gitBranchLabel0": "#ffffff",
    "gitBranchLabel1": "#ffffff",
    "gitBranchLabel2": "#ffffff",
    "gitBranchLabel3": "#ffffff",
    "gitBranchLabel4": "#ffffff",
    "tagLabelColor": "#ffffff",
    "tagLabelBackground": "#D85810",
    "tagLabelBorder": "#D85810",
    "tagLabelFontSize": "14px"
  },
  "themeCSS": ".accent rect, .accent polygon, .accent path { fill: #D85810 !important; stroke: #D85810 !important; } .accent text, .accent tspan { fill: #ffffff !important; } .attention rect, .attention polygon { fill: #fbe9df !important; stroke: #D85810 !important; } .discret rect, .discret polygon { fill: #f3f1ec !important; stroke: #6b6b6b !important; stroke-dasharray: 5 4; }"
}
