# Les reglages du portail technique, tous documentes, aucun secret.
#
# CE FICHIER FAIT AUTORITE. Une variable que la composition emploie et qui n est
# pas decrite ici n existe pas: un test du portail compare cette liste aux
# variables de compose.yaml et de compose.override.yaml, dans les deux sens.
#
# COMMENT S EN SERVIR
#
# Le fichier .env, a cote, en est une copie a l identique, versionnee
# (decision 46): un clone du depot se lance donc tel quel, sans rien remplir.
# Pour changer une valeur sur son poste, on la change dans .env; pour en
# ajouter une, on l ajoute ici ET dans .env.
#
# LES TROIS NIVEAUX
#
# Chaque variable dit a quel niveau elle sert.
#   local        le poste du developpeur: les valeurs de ce fichier
#   test         l application Coolify portail-test
#   production   l application Coolify portail-production
# En test et en production, Coolify ne lit pas ce fichier: il ecrit le sien,
# a partir des variables de l application. Les valeurs ci-dessous ne valent
# donc que pour le poste.
#
# CE QUI N A PAS SA PLACE ICI
#
# Aucun identifiant de l application GitHub, aucun mot de passe reel: en local,
# le portail n en a pas besoin. En test et en production, ils vivent dans les
# variables de l application Coolify, posees depuis secret_root/ par
# l assistant de deploiement.


# ---------------------------------------------------------------------------
# Le deploiement
# ---------------------------------------------------------------------------

# Le nom qui prefixe les conteneurs, le reseau et le volume.
# Niveau: local. Defaut: portail. Obligatoire: non.
# Deux copies du portail sur un meme poste prennent deux noms differents. En
# test et en production, Coolify impose le sien.
OSCAR_NOM_DU_DEPLOIEMENT=portail


# ---------------------------------------------------------------------------
# L image du portail
#
# En test et en production, Coolify met en ligne une image deja construite et
# rangee dans l entrepot d images d OSCAR (Harbor), jamais une construction.
# Sur le poste, compose.override.yaml construit l image sous ce meme nom, sans
# jamais demander l entrepot. Vides ici: chaque valeur par defaut de
# compose.yaml s applique.
# ---------------------------------------------------------------------------

# L adresse de l entrepot d images.
# Niveau: test, production. Defaut: registry-container.oscar-bot.com.
# Obligatoire: non. Une autre machine, avec son propre entrepot, la change ici
# et sur ses applications Coolify.
ADRESSE_ENTREPOT_IMAGES=

# L etiquette de l image a mettre en ligne.
# Niveau: test, production. Le deploiement automatique la pose sur
# l application Coolify (contenu-<empreinte du contenu>) avant chaque mise en
# ligne. Pour revenir en arriere: une etiquette en-production-depuis-le-<date>
# precedente, puis « Redeploy » dans Coolify (decision 101).
# Defaut: construite-sur-le-poste-du-developpeur, l etiquette de l image
# construite en local, qui n existe pas dans l entrepot. Obligatoire: non.
ETIQUETTE_IMAGE_A_METTRE_EN_LIGNE=


# ---------------------------------------------------------------------------
# Les ports publies sur le poste
#
# Niveau: local seulement. Le bloc 185xx du portail, toujours sur 127.0.0.1
# (_pilotage/09-CONVENTION-des-ports.md). Lus par compose.override.yaml, que
# Coolify ne lit pas.
# ---------------------------------------------------------------------------

# Le mode service. Defaut: 18500. Obligatoire: non.
OSCAR_PORT_PUBLIE_PORTAIL=18500

# Le mode developpement: l interface. Defaut: 18501. Obligatoire: non.
# Le conteneur de developpement le recoit aussi, pour fabriquer ses adresses.
OSCAR_PORT_PUBLIE_INTERFACE_DEVELOPPEMENT=18501

# Le mode developpement: le serveur. Defaut: 18502. Obligatoire: non.
# Le conteneur de developpement le recoit aussi, pour fabriquer ses adresses.
OSCAR_PORT_PUBLIE_SERVEUR_DEVELOPPEMENT=18502


# ---------------------------------------------------------------------------
# L adresse publique
# ---------------------------------------------------------------------------

# L adresse a laquelle on ouvre le portail dans un navigateur, sans barre
# oblique finale. Elle fabrique les liens et l adresse de retour de la
# connexion GitHub.
# Niveau: local; en test et en production, Coolify la calcule lui-meme depuis
# le domaine de l application (https://test-tech.oscar-bot.com,
# https://tech.oscar-bot.com). C est pourquoi elle porte ce nom, qui est celui
# que Coolify lui donne.
# Obligatoire: oui.
# En local, elle se deduit du port du mode service, ecrit une seule fois plus
# haut: docker compose remplace ${...} par la valeur deja lue.
SERVICE_URL_PORTAIL=http://127.0.0.1:${OSCAR_PORT_PUBLIE_PORTAIL}


# ---------------------------------------------------------------------------
# La base de donnees
# ---------------------------------------------------------------------------

# Le compte de la base.
# Niveau: local, test, production. Defaut: backstage. Obligatoire: non.
POSTGRES_UTILISATEUR=backstage

# Le mot de passe de la base.
# Niveau: local; en test et en production, l assistant de deploiement le pose
# sur l application Coolify depuis secret_root/portail/<environnement>/: chaque
# environnement a le sien.
# Obligatoire: oui.
# La valeur ci-dessous n est pas un secret: la base n est joignable que depuis
# le reseau Docker du poste, et ne contient que des donnees d essai.
POSTGRES_MOT_DE_PASSE=portail-en-local


# ---------------------------------------------------------------------------
# L application GitHub du portail
#
# Niveau: test et production seulement. En local, elles restent absentes: le
# portail s ouvre en invite et ne lit pas GitHub. En test et en production,
# l assistant de deploiement les pose sur l application Coolify, en lisant
# secret_root/; elles ne s ecrivent jamais ici. Le portail refuse de demarrer
# en test ou en production si l une manque.
# ---------------------------------------------------------------------------

# L identifiant numerique de l application GitHub (App ID).
GITHUB_APP_ID=

# L identifiant de client de l application (Client ID), pour la connexion.
GITHUB_CLIENT_ID=

# Le secret de client de l application (Client secret), pour la connexion.
GITHUB_CLIENT_SECRET=

# La cle privee de l application, sur plusieurs lignes, pour lire
# l organisation: les depots, les personnes et les equipes.
GITHUB_APP_PRIVATE_KEY=
