# Portail de gouvernance - reglages
#
# Copiez en .env et remplissez. Aucune valeur n est ecrite dans compose.yaml :
# c est ce qui permet de deplacer le portail sur une autre machine sans
# toucher au code.

# --- L adresse publique ---
# Sert a fabriquer les liens et le retour de connexion GitHub.
# En local : http://localhost:7007
OSCAR_PORTAIL_URL=https://tech.oscar-bot.com

# --- La base ---
POSTGRES_UTILISATEUR=backstage
POSTGRES_MOT_DE_PASSE=

# --- Signature des sessions ---
# A produire avec :  openssl rand -base64 32
# Si elle change, tout le monde est deconnecte.
BACKEND_SECRET=

# --- Lecture de l organisation GitHub ---
# Un jeton en LECTURE SEULE sur l organisation suffit. Il sert a decouvrir les
# depots et a savoir qui a acces a quoi.
GITHUB_TOKEN=

# --- Connexion des personnes par GitHub ---
# A creer dans GitHub : Settings de l organisation, Developer settings,
# OAuth Apps. L adresse de retour doit etre exactement :
#   https://tech.oscar-bot.com/api/auth/github/handler/frame
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
